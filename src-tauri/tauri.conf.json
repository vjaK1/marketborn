{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marketborn",
  "version": "1.0.0",
  "identifier": "com.marketborn.app",
  "build": {
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Marketborn",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
